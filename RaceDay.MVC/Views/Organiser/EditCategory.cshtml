@model RaceDay.MVC.Models.CategoryViewModel

@{
    ViewData["Title"] = "Edit Category";
}

<div class="container py-4">

    <div class="card shadow-sm border-0 rounded-4 p-4">

        <h2 class="fw-bold mb-3">Edit Race Category</h2>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }

        <form asp-action="EditCategory" method="post">

            <input type="hidden" asp-for="CategoryID" />
            <input type="hidden" asp-for="EventID" />

            <div class="mb-3">
                <label asp-for="CategoryName" class="form-label">
                    Category Name
                </label>
                <input asp-for="CategoryName" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="Distance" class="form-label">
                    Distance (km)
                </label>
                <input asp-for="Distance"
                       type="number"
                       step="0.01"
                       class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="EntryFee" class="form-label">
                    Entry Fee (R)
                </label>
                <input asp-for="EntryFee"
                       type="number"
                       step="0.01"
                       class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="MaximumParticipants"
                       class="form-label">
                    Maximum Participants
                </label>
                <input asp-for="MaximumParticipants"
                       type="number"
                       class="form-control" />
            </div>

            <button type="submit"
                    class="btn btn-primary rounded-pill px-4">
                Save Changes
            </button>

            <a asp-action="ManageCategories"
               asp-route-id="@Model.EventID"
               class="btn btn-outline-secondary rounded-pill">
                Cancel
            </a>

        </form>

    </div>
</div>