@model List<RaceDay.MVC.Models.EventViewModel>

@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="container py-4">

    <div class="p-4 mb-4 rounded-4 text-white"
         style="background: linear-gradient(120deg, #172554, #2563eb);">

        <h1 class="fw-bold">Organiser Dashboard 🏁</h1>

        <p class="mb-0">
            Manage your RaceDay events and keep every race moving.
        </p>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Error
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold">My Events</h3>
            <p class="text-muted mb-0">
                View and manage the events you organise.
            </p>
        </div>

        <a asp-controller="Organiser"
           asp-action="CreateEvent"
           class="btn btn-primary rounded-pill px-4">
            + Create Event
        </a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="text-center p-5 bg-light rounded-4">
            <h5>No events created yet.</h5>
            <p class="text-muted">
                Create your first event to get started.
            </p>

            <a asp-controller="Organiser"
               asp-action="CreateEvent"
               class="btn btn-primary rounded-pill">
                Create Your First Event
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var raceEvent in Model)
            {
                <div class="col-md-6 col-lg-4">

                    <div class="card h-100 border-0 shadow-sm rounded-4">

                        <div class="card-body p-4">

                            <span class="badge bg-primary mb-3">
                                Race Event
                            </span>

                            <h5 class="fw-bold">
                                @raceEvent.EventName
                            </h5>

                            <p class="text-muted">
                                @raceEvent.Description
                            </p>

                            <p class="mb-2">
                                <strong>Location:</strong>
                                @raceEvent.Location, @raceEvent.Province
                            </p>

                            <p class="mb-2">
                                <strong>Race Date:</strong>
                                @raceEvent.RaceDate.ToString("dd MMM yyyy")
                            </p>

                            <p class="mb-3">
                                <strong>Registration Deadline:</strong>
                                @raceEvent.RegistrationDeadline.ToString("dd MMM yyyy")
                            </p>

                            <hr />

                            <a asp-controller="Organiser"
                               asp-action="EditEvent"
                               asp-route-id="@raceEvent.EventID"
                               class="btn btn-outline-primary btn-sm rounded-pill">
                                Edit Event
                            </a>

                            <a asp-controller="Organiser"
                               asp-action="ManageCategories"
                               asp-route-id="@raceEvent.EventID"
                               class="btn btn-outline-secondary btn-sm rounded-pill">
                                Categories
                            </a>

                        </div>
                    </div>
                </div>
            }

        </div>
    }

</div>